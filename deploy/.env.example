# EC2의 ~/app/.env 로 복사해서 실제 값을 채운다. 이 파일(.env.example)에는 실제 값을 넣지 않는다.

# Caddy가 인증서를 발급받을 도메인
DOMAIN=dolabom.duckdns.org

# RDS 접속 정보 (엔드포인트: RDS 콘솔 → dolabom-db → 연결 및 보안)
DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/hosun?sslmode=require
DB_USERNAME=hosun_admin
DB_PASSWORD=

# 32바이트 이상. 서버에서 `openssl rand -base64 48` 로 생성
JWT_SECRET=

# 비워 두면 AI 대신 규칙 기반 문장으로 응답한다
GEMINI_API_KEY=
# 모델을 바꿀 때만 지정 (기본값은 application.yml)
# GEMINI_MODEL=

# 허용할 프론트 주소. 쉼표로 구분, 공백 없이. Vercel 주소가 나오면 뒤에 추가한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173